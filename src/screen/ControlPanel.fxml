<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="360.0" spacing="12.0" style="-fx-padding: 12; -fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ControlPanelController">
   <children>
      <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Control Panel" />
      <VBox spacing="6.0" style="-fx-padding: 8;">
         <children>
            <Label fx:id="elapsedTimeLabel" text="Elapsed: 0.0 s (0 ticks)" />
            <Label fx:id="seasonLabel" text="Season: Spring" />
            <Label fx:id="entityStatsLabel" text="Entities: 0" />
         </children>
      </VBox>
      <VBox spacing="6.0" style="-fx-padding: 8;">
         <children>
            <Label text="Asset Mode" />
            <Label fx:id="activeAssetModeLabel" text="Current mode: basic" />
            <ComboBox fx:id="assetModeBox" maxWidth="1.7976931348623157E308" />
         </children>
      </VBox>
      <VBox spacing="6.0" style="-fx-padding: 8;">
         <children>
            <Label text="Spawn Entity / Place Block" />
            <CheckBox fx:id="spawnModeCheckBox" mnemonicParsing="false" text="Enable Spawn Mode" />
            <Label fx:id="spawnModeStatusLabel" text="Spawn mode: OFF" />
            <Label text="Spawn Kind" />
            <ComboBox fx:id="spawnKindBox" maxWidth="1.7976931348623157E308" />
            <Label text="Spawn Type" />
            <ComboBox fx:id="spawnTypeBox" maxWidth="1.7976931348623157E308" />
         </children>
      </VBox>
      <VBox>
         <children>
            <Label text="Zoom">
               <VBox.margin>
                  <Insets left="10.0" />
               </VBox.margin>
            </Label>
            <Slider fx:id="zoomSlider" blockIncrement="0.1" majorTickUnit="1.0" max="5.0" min="0.2" showTickLabels="true" showTickMarks="true" value="1.0">
               <VBox.margin>
                  <Insets top="5.0" />
               </VBox.margin>
            </Slider>
         </children>
      </VBox>
   </children>
</VBox>
